    "nylas": "^7.5.2",
    "openai": "^4.71.1",
    "otpauth": "^9.3.5",
    "otplib": "^12.0.1",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-day-picker": "^9.6.0",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.53.2",
    "react-joyride": "^2.9.2",
    "recharts": "^2.13.3",
    "resend": "^4.0.1",
    "sharp": "^0.34.5",
    "sonner": "^1.7.1",
    "stripe": "^17.2.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.5.6",
    "twilio": "^5.3.5",
    "ua-parser-js": "^1.0.39",
    "uuid": "^10.0.0",
    "vaul": "^1.1.1",
