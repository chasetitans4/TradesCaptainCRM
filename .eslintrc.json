{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-console": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "react-hooks/exhaustive-deps": "off"
  },
  "ignorePatterns": [
    "next.config.js",
    "postcss.config.js",
    "public/**/*",
    "scripts/**/*"
  ],
  "overrides": [
    {
      "files": ["*.js", "**/*.js"],
      "parserOptions": {
        "project": null
      }
    }
  ]
}
