    "@types/react-dom": "^19.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.0.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "postcss": "^8.4.47",
    "supabase": "^2.72.8",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "^6.14.1",
    "tar": "^7.5.6",
    "lodash": "^4.17.21"
  }
}
