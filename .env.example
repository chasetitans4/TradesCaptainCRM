# ==============================================
# TRADES CAPTAIN CRM - Environment Configuration
# ==============================================
# Copy this file to .env.local for development
# Do NOT commit .env.local to version control
# ==============================================

# ---------------------------------------------
# APPLICATION
# ---------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TradesCaptain

# ---------------------------------------------
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard
# ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------
# AUTHENTICATION
# ---------------------------------------------
# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-minimum-32-characters

# Session expiry in seconds (default: 7 days)
SESSION_EXPIRY=604800

# ---------------------------------------------
# STRIPE (Payment Processing)
# Get these from: https://dashboard.stripe.com/apikeys
# ---------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for subscription plans
# TODO: Create these in Stripe Dashboard and update
STRIPE_PRICE_BLUE_SOLO_MONTHLY=price_xxx
STRIPE_PRICE_BLUE_SOLO_ANNUAL=price_xxx
STRIPE_PRICE_BLUE_TEAM_MONTHLY=price_xxx
STRIPE_PRICE_BLUE_TEAM_ANNUAL=price_xxx
STRIPE_PRICE_BLUE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BLUE_BUSINESS_ANNUAL=price_xxx

# ---------------------------------------------
# TWILIO (SMS/Voice)
# Get these from: https://console.twilio.com
# ---------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ---------------------------------------------
# RESEND (Email)
# Get these from: https://resend.com/api-keys
# ---------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------
# OPENAI (AI Features)
# Get these from: https://platform.openai.com/api-keys
# ---------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview

# ---------------------------------------------
# NYLAS (Email/Calendar Integration)
# Get these from: https://dashboard.nylas.com
# ---------------------------------------------
NYLAS_CLIENT_ID=your-client-id
NYLAS_CLIENT_SECRET=your-client-secret
NYLAS_API_KEY=your-api-key
NYLAS_API_URI=https://api.us.nylas.com

# ---------------------------------------------
# SENTRY (Error Monitoring)
# Get these from: https://sentry.io
# ---------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=trades-captain-crm
SENTRY_AUTH_TOKEN=sntrys_xxx

# ---------------------------------------------
# GOOGLE (Maps, Reviews, OAuth)
# Get these from: https://console.cloud.google.com
# ---------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxx
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ---------------------------------------------
# RATE LIMITING
# ---------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------
# FEATURE FLAGS
# ---------------------------------------------
NEXT_PUBLIC_ENABLE_AI_SMS=false
NEXT_PUBLIC_ENABLE_ROUTE_OPTIMIZATION=false
NEXT_PUBLIC_ENABLE_ONLINE_BOOKING=false

# ---------------------------------------------
# ADMIN PORTAL
# ---------------------------------------------
ADMIN_PORTAL_SECRET=your-admin-secret
ADMIN_ALLOWED_EMAILS=admin@yourdomain.com

# ==============================================
# PRODUCTION OVERRIDES
# ==============================================
# These should be set differently in production:
# - NODE_ENV=production
# - Use production API keys (not test keys)
# - Set stricter CORS policies
# - Enable all security features
# ==============================================
